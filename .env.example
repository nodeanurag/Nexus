# -----------------------------------------------------------------------------
# OpsHub environment variables — copy to `.env` and fill in real values.
# -----------------------------------------------------------------------------

# Supabase Postgres.
# DATABASE_URL  -> pooled connection (Transaction mode, port 6543) used by the app.
# DIRECT_URL    -> direct connection (Session mode, port 5432) used for migrations.
# Find both under: Supabase Dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth v5).
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Auth.js). Set to the deployed URL in production.
AUTH_URL="http://localhost:3000"
